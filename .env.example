# Supabase
# Base URL of your Supabase project, e.g. https://xyzcompany.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# Public anon key from your Supabase project settings (safe to expose)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key from your Supabase project settings.
# SERVER-ONLY. Never expose to the browser, never commit to git.
SUPABASE_SERVICE_ROLE_KEY=

# Site
# Branding (site name, tagline, colors) lives in src/lib/config.ts --
# there is intentionally no SITE_NAME env var.

# Video upload limits (enforced client-side for UX, server-side for security)
NEXT_PUBLIC_MAX_VIDEO_MB=100
NEXT_PUBLIC_MAX_VIDEO_SECONDS=180
